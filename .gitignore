# Build output tree (symlink to external volume)
ios_build

# Xcode
iosApp/build/
xcuserdata/

# Embedded engine binaries — regenerated from the ios_build tree:
#   cp -L ios_build/ios-libs/OS64/lib/<name> iosApp/EmbeddedLibsDevice/
#   cp -L ios_build/ios-libs/SIMULATORARM64/lib/<name> iosApp/EmbeddedLibsSim/
# EmbeddedLibs/ itself is synced from one of those by the "Select Platform
# Libraries" build phase depending on the build destination.
iosApp/EmbeddedLibs/
iosApp/EmbeddedLibsDevice/
iosApp/EmbeddedLibsSim/

# Gradle / Kotlin
.gradle/
.kotlin/
build/
composeApp/build/

# macOS
.DS_Store
