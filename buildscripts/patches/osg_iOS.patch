From 3758d48f293aeff807d27613fb9cafa3e726e32a Mon Sep 17 00:00:00 2001
From: Duron27 <duron27@gmail.com>
Date: Mon, 12 Jan 2026 17:26:10 -0500
Subject: [PATCH] osg_iOS

---
 CMakeLists.txt                          | 16 ++++--
 src/OpenThreads/pthreads/CMakeLists.txt |  2 +-
 src/osgDB/FileUtils.cpp                 | 66 ++++++++++++++++++++++++-
 3 files changed, 76 insertions(+), 8 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -65,12 +65,19 @@
     IF(OSG_BUILD_PLATFORM_IPHONE)
 
         # set sdk and min versions
-        SET (IPHONE_SDKVER "10.2" CACHE STRING "IOS SDK-Version")
-        SET (IPHONE_VERSION_MIN "7.0" CACHE STRING "IOS minimum os version, use 7.0 or greater to get 64bit support")
+        SET (IPHONE_SDKVER "26.2" CACHE STRING "IOS SDK-Version")
+        SET (IPHONE_VERSION_MIN "13" CACHE STRING "IOS minimum os version, use 7.0 or greater to get 64bit support")
 
-        # get full path to sdk from requested versions
-        SET (IPHONE_DEVROOT "/Applications/Xcode.app/Contents/Developer/Platforms/iPhoneOS.platform/Developer")
-        SET (IPHONE_SDKROOT "${IPHONE_DEVROOT}/SDKs/iPhoneOS${IPHONE_SDKVER}.sdk")
+        # get full path to sdk from requested versions; honour the ios-cmake
+        # toolchain's PLATFORM so simulator builds use the simulator SDK
+        EXECUTE_PROCESS(COMMAND xcode-select -p OUTPUT_VARIABLE OSG_XCODE_DEVELOPER_DIR OUTPUT_STRIP_TRAILING_WHITESPACE)
+        IF(DEFINED PLATFORM AND PLATFORM MATCHES "SIMULATOR")
+            SET (IPHONE_DEVROOT "${OSG_XCODE_DEVELOPER_DIR}/Platforms/iPhoneSimulator.platform/Developer")
+            SET (IPHONE_SDKROOT "${IPHONE_DEVROOT}/SDKs/iPhoneSimulator${IPHONE_SDKVER}.sdk")
+        ELSE()
+            SET (IPHONE_DEVROOT "${OSG_XCODE_DEVELOPER_DIR}/Platforms/iPhoneOS.platform/Developer")
+            SET (IPHONE_SDKROOT "${IPHONE_DEVROOT}/SDKs/iPhoneOS${IPHONE_SDKVER}.sdk")
+        ENDIF()
 
         # optionally enable bitcode for the build
         SET (IPHONE_ENABLE_BITCODE "NO" CACHE STRING "IOS Enable Bitcode")
@@ -235,12 +242,14 @@
 IF(APPLE)
 
     IF(OSG_BUILD_PLATFORM_IPHONE)
-
         # set the sdk path as our sysroot, if we set this before the project is defined cmake fails to build its test program
         SET(CMAKE_OSX_SYSROOT "${IPHONE_SDKROOT}" CACHE STRING "System root for iOS" FORCE)
 
         # Set the path to OpenGL library
-        SET(OPENGL_gl_LIBRARY "${IPHONE_SDKROOT}/System/Library/Frameworks/OpenGLES.framework")
+        IF(NOT DEFINED OPENGL_gl_LIBRARY)
+            SET(OPENGL_gl_LIBRARY "${IPHONE_SDKROOT}/System/Library/Frameworks/OpenGLES.framework" CACHE STRING "" FORCE)
+        ENDIF()
+        SET(OPENGL_LIBRARIES ${OPENGL_gl_LIBRARY})
 
     ELSE ()
         FIND_LIBRARY(CARBON_LIBRARY Carbon)
@@ -314,6 +323,9 @@
 INCLUDE_DIRECTORIES(${OpenSceneGraph_SOURCE_DIR}/include/)
 
 INCLUDE_DIRECTORIES(SYSTEM ${OPENGL_INCLUDE_DIR})
+IF(NOT DEFINED OPENGL_INCLUDE_DIR)
+    INCLUDE_DIRECTORIES(${IPHONE_SDKROOT}/System/Library/Frameworks/OpenGLES.framework/Headers)
+ENDIF()
 
 # Common global definitions
 #ADD_DEFINITIONS(-D)
@@ -597,8 +609,13 @@
     ENDIF()
 ELSE()
     IF (APPLE)
-        SET(OPENGL_HEADER1 "#include <OpenGL/gl.h>" CACHE STRING "#include<> line for OpenGL Header")
-        SET(OPENGL_HEADER2 "" CACHE STRING "#include<> line for additional OpenGL Headers if required")
+        IF(OSG_BUILD_PLATFORM_IPHONE)
+            SET(OPENGL_HEADER1 "#include <OpenGLES/ES3/gl.h>" CACHE STRING "#include<> line for OpenGL Header")
+            SET(OPENGL_HEADER2 "" CACHE STRING "#include<> line for additional OpenGL Headers if required")
+        ELSE()
+            SET(OPENGL_HEADER1 "#include <OpenGL/gl.h>" CACHE STRING "#include<> line for OpenGL Header")
+            SET(OPENGL_HEADER2 "" CACHE STRING "#include<> line for additional OpenGL Headers if required")
+        ENDIF()
     ELSE()
         SET(OPENGL_HEADER1 "#include <GL/gl.h>" CACHE STRING "#include<> line for OpenGL Header")
         SET(OPENGL_HEADER2 "" CACHE STRING "#include<> line for additional OpenGL Headers if required")
