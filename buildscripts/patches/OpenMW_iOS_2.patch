-        snprintf(argv0, sizeof(argv0), "%s", argv[0]);
-        return;
-    }
-
-    if (getcwd(argv0, sizeof(argv0)) == nullptr)
-    {
-        Log(Debug::Error) << "Failed to call getcwd: " << std::generic_category().message(errno);
-        return;
-    }
