-    Log(Debug::Warning) << "Failed to call sysctl: " << std::generic_category().message(errno);
-#endif
-
-#if defined(__APPLE__)
-    if (proc_pidpath(getpid(), argv0, sizeof(argv0)) > 0)
-        return;
