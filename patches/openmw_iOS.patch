+if(CMAKE_SYSTEM_NAME MATCHES "iOS" OR CMAKE_OSX_SYSROOT MATCHES "iphoneos")
+    set(IOS TRUE)
+endif()
+
 # Version file
 set (VERSION_RESOURCE_FILE_IN "${OpenMW_SOURCE_DIR}/files/version.in")
 set (VERSION_RESOURCE_FILE_RELATIVE "resources/version")
@@ -400,7 +405,7 @@ if(WIN32)
         windowscrashmonitor
         windowscrashshm
     )
-elseif(NOT ANDROID)
+elseif(NOT ANDROID AND NOT IOS)
     add_component_dir (crashcatcher
         crashcatcher
     )
